FROM node:22-alpine AS deps
WORKDIR /app

RUN apk add --no-cache openssl

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci

FROM deps AS builder
WORKDIR /app
COPY . .
RUN npm run build -w @allvision/database \
  && npm run build -w @allvision/shared \
  && npm run build -w @allvision/api

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN apk add --no-cache curl openssl \
  && addgroup -S -g 10001 allvision \
  && adduser -S -D -H -u 10001 -G allvision allvision

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci --omit=dev

COPY --from=builder --chown=allvision:allvision /app/apps/api/dist apps/api/dist
COPY --from=builder --chown=allvision:allvision /app/packages/database/dist packages/database/dist
COPY --from=builder --chown=allvision:allvision /app/packages/database/prisma packages/database/prisma
COPY --from=builder --chown=allvision:allvision /app/packages/shared/dist packages/shared/dist

RUN npx prisma generate --schema packages/database/prisma/schema.prisma
RUN mkdir -p /app/uploads && chown -R allvision:allvision /app

USER allvision
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -fsS http://127.0.0.1:4000/api/ready || exit 1

CMD ["sh", "-c", "npx prisma migrate deploy --schema packages/database/prisma/schema.prisma && node packages/database/dist/seed.js && node apps/api/dist/index.js"]
