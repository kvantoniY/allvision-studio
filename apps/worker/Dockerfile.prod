FROM node:22-alpine AS deps
WORKDIR /app
ENV NPM_CONFIG_FETCH_RETRIES=5 \
  NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=20000 \
  NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=120000 \
  NPM_CONFIG_FETCH_TIMEOUT=600000

RUN apk add --no-cache openssl

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci && npm cache clean --force

FROM deps AS builder
WORKDIR /app
COPY . .
RUN npm run build -w @allvision/database \
  && npm run build -w @allvision/shared \
  && npm run build -w @allvision/worker \
  && npm prune --omit=dev \
  && npm cache clean --force

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Шрифты нужны sharp для отрисовки титров: без системных шрифтов кириллица
# в SVG превращается в пустые прямоугольники.
RUN apk add --no-cache ffmpeg openssl font-noto ttf-dejavu fontconfig \
  && (deluser node 2>/dev/null || true) \
  && (delgroup node 2>/dev/null || true) \
  && addgroup -S -g 1000 allvision \
  && adduser -S -D -H -u 1000 -G allvision allvision

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json

COPY --from=builder /app/node_modules node_modules
COPY --from=builder --chown=allvision:allvision /app/apps/worker/dist apps/worker/dist
COPY --from=builder --chown=allvision:allvision /app/packages/database/dist packages/database/dist
COPY --from=builder --chown=allvision:allvision /app/packages/database/prisma packages/database/prisma
COPY --from=builder --chown=allvision:allvision /app/packages/shared/dist packages/shared/dist
COPY --from=builder --chown=allvision:allvision /app/apps/api/demo-assets apps/api/demo-assets

RUN npx prisma generate --schema packages/database/prisma/schema.prisma
RUN mkdir -p /app/uploads && chown -R allvision:allvision /app

USER allvision
CMD ["node", "apps/worker/dist/index.js"]
