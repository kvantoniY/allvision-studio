# Providers
PROVIDER_MODE=mock
STORAGE_PUBLISHER=local

# PiAPI (только PROVIDER_MODE=piapi)
PIAPI_API_KEY=
PIAPI_BASE_URL=https://api.piapi.ai
PIAPI_DAILY_CAP_USD=5
PIAPI_BALANCE_MIN_USD=2
# GPT Image идёт синхронным запросом и может отвечать дольше обычных 30s (мс)
PIAPI_GPT_IMAGE_TIMEOUT_MS=180000
# Сколько раз пробовать gpt-image edit при РАННЕМ обрыве соединения (RST до первого байта
# ответа, запрос не дошёл до PiAPI). Default 4; поздние обрывы/таймауты не ретраятся.
PIAPI_GPT_IMAGE_EDIT_RETRIES=4
ALLOW_REAL_PIAPI_IN_TEST=

# Generated project retention cleanup
GENERATION_CLEANUP_INTERVAL_MINUTES=360
GENERATION_CLEANUP_BATCH_SIZE=100
GENERATION_CLEANUP_MAX_BATCHES=10

# Cloudflare R2 для STORAGE_PUBLISHER=r2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_TEMP_PREFIX=piapi-temp
