FROM node:22-alpine AS deps
WORKDIR /app

RUN apk add --no-cache openssl

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci

FROM deps AS builder
WORKDIR /app
COPY . .
ARG NEXT_PUBLIC_API_URL=https://allvision-pulse.ru
ARG PUBLIC_API_URL=https://allvision-pulse.ru
ARG PUBLIC_WEB_URL=https://allvision-pulse.ru
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV PUBLIC_API_URL=$PUBLIC_API_URL
ENV PUBLIC_WEB_URL=$PUBLIC_WEB_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build -w @allvision/database \
  && npm run build -w @allvision/shared \
  && npm run build -w @allvision/web

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN apk add --no-cache curl openssl \
  && (deluser node 2>/dev/null || true) \
  && (delgroup node 2>/dev/null || true) \
  && addgroup -S -g 1000 allvision \
  && adduser -S -D -H -u 1000 -G allvision allvision

COPY --from=builder --chown=allvision:allvision /app/apps/web/.next/standalone ./
COPY --from=builder --chown=allvision:allvision /app/apps/web/.next/static apps/web/.next/static
COPY --from=builder --chown=allvision:allvision /app/apps/web/public apps/web/public

USER allvision
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -fsS http://127.0.0.1:3000/ || exit 1

CMD ["node", "apps/web/server.js"]
