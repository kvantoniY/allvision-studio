generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === USER ===

enum Role {
  USER
  ADMIN
}

model User {
  id             String  @id @default(cuid())
  email          String  @unique
  password       String
  name           String?
  role           Role    @default(USER)
  coinBalance    Int     @default(25)
  emailVerified  Boolean @default(false)
  freeAvatarUsed Boolean @default(false)
  freeVoiceUsed  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reverse relations
  transactions CoinTransaction[]
  avatars      Avatar[]
  voices       Voice[]
  scenes       Scene[]
  generations  Generation[]
  chatThreads  ChatThread[]
}

model CoinTransaction {
  id           String  @id @default(cuid())
  userId       String
  amount       Int // negative = debit, positive = credit
  reason       String // "topup" | "generation" | "regenerate" | "refund" | "welcome_bonus" | "avatar_slot" | "voice_slot" | "watermark_removal"
  balanceAfter Int
  refType      String? // "Generation" | "Avatar" | "Voice" | "Topup"
  refId        String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// === STUDIO LIBRARY ===

enum AvatarType {
  HUMAN
  PET
  OBJECT
  OTHER
}

enum AvatarStatus {
  PROCESSING
  READY
  REJECTED
}

model Avatar {
  id              String       @id @default(cuid())
  userId          String
  name            String
  type            AvatarType
  referenceImages String[]
  primaryImageId  Int          @default(0)
  description     String?      @db.Text
  status          AvatarStatus @default(PROCESSING)
  nsfwChecked     Boolean      @default(false)
  isPaid          Boolean      @default(false)
  usedCount       Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum VoiceSourceType {
  UPLOADED // user uploaded audio to clone
  CLONED // saved cloned voice
  PRESET // system voice from the library
}

enum VoiceStatus {
  PROCESSING
  READY
  REJECTED
}

model Voice {
  id              String          @id @default(cuid())
  userId          String? // null for PRESET
  name            String
  sourceType      VoiceSourceType
  sourceAudio     String? // uploaded audio URL
  providerVoiceId String? // TTS provider-side ID
  linkedAvatarId  String?
  status          VoiceStatus     @default(PROCESSING)
  isPaid          Boolean         @default(false)
  isSystem        Boolean         @default(false) // for PRESET
  previewAudio    String? // short preview audio URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Scene {
  id              String   @id @default(cuid())
  userId          String
  name            String
  description     String   @db.Text
  referenceImages String[]
  category        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// === GENERATION CORE ===

enum GenerationKind {
  TEXT
  AUDIO
  IMAGE
  VIDEO
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ChatThread {
  id     String @id @default(cuid())
  userId String
  title  String // auto from first message, editable by user

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations Generation[]

  @@index([userId, updatedAt])
}

model Generation {
  id       String           @id @default(cuid())
  userId   String
  kind     GenerationKind
  mode     String // "chat" | "tts" | "text-to-image" | "image-to-image" | "animate" | "face-swap" | "image-to-video" | "text-to-video" | "preset-photo-restore" | etc.
  status   GenerationStatus @default(PENDING)
  progress Int              @default(0)

  // Inputs
  prompt      String?  @db.Text
  inputImages String[]
  inputVideo  String?
  inputAudio  String?

  // Studio attachments
  avatarIds String[]
  sceneId   String?
  voiceId   String?

  // AI params
  aiProvider      String // "fal" | "openai" | "elevenlabs" | "mock"
  aiModel         String
  aiConfig        Json?
  durationSeconds Int?
  aspectRatio     String?
  style           String?

  // Outputs
  resultText      String? @db.Text
  resultImage     String?
  resultVideo     String?
  resultAudio     String?
  resultThumbnail String?

  // Finance
  coinsCost Int

  // Regeneration
  parentGenerationId String?
  watermarkRemoved   Boolean @default(false)

  // Chat thread (TEXT only; otherwise null)
  threadId String?

  // Meta
  aiProviderJobId String?
  aiProviderLogs  Json?
  errorMessage    String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread ChatThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([userId, kind, createdAt])
  @@index([threadId, createdAt])
}

// === PRESETS ===

enum PresetCategory {
  PHOTO_RESTORE
  PHOTO_ANIMATE
  PHOTO_ENHANCE_AND_ANIMATE
  TREND_DANCE
  TREND_OTHER
  AUDIO_PRESET
  TEXT_PRESET
  OTHER
}

model PresetRecipe {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  shortDesc   String         @db.Text
  description String         @db.Text
  category    PresetCategory
  kind        GenerationKind // generated result kind
  mode        String // mode for resulting Generation

  promptTemplate String? @db.Text
  promptHint     String?
  needsInput     Boolean @default(true)
  acceptedInput  String?

  aiProvider String
  aiModel    String
  aiConfig   Json?

  coinsCost Int

  previewImage String
  previewVideo String?

  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  tags       String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
