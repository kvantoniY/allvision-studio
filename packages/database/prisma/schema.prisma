generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Пользователи ===
model User {
  id                     String         @id @default(cuid())
  email                  String         @unique
  passwordHash           String
  name                   String?
  avatar                 String?
  tokenBalance           Int            @default(0)
  freeCharacterUsed      Boolean        @default(false)
  role                   Role           @default(USER)
  messenger              String?
  messengerType          MessengerType?
  emailVerifiedAt        DateTime?
  emailVerifyToken       String?
  emailVerifyExpiresAt   DateTime?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  deletedAt              DateTime?
  createdAt              DateTime       @default(now())

  projects   Project[]
  payments   Payment[]
  orders     Order[]
  tokenTxns  TokenTransaction[]
  fairyTales FairyTaleScriptRecord[]
  characters Character[]
  scenes     Scene[]
  episodes   Episode[]
  mediaAssets MediaAsset[]
  chats     Chat[]
  videoProjects VideoProject[]
  customOrders  CustomOrder[]
  customOrderMessages CustomOrderMessage[]
  supportTickets SupportTicket[] @relation("SupportTicketOwner")
  supportMessages SupportMessage[] @relation("SupportMessageAuthor")
  resolvedSupportTickets SupportTicket[] @relation("SupportTicketResolvedBy")
}

enum Role {
  USER
  ADMIN
  READONLY_ADMIN
}

enum MessengerType {
  TELEGRAM
  WHATSAPP
  VK
  PHONE
}

// === Каталог услуг ===
model Service {
  id             String  @id @default(cuid())
  slug           String  @unique
  title          String
  description    String  @db.Text
  shortDesc      String
  category       String
  priceTokens    Int
  costUsd        Float
  coverImage     String?
  galleryImages  String[]
  isActive       Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  sortOrder      Int             @default(0)
  // Порядок в кураторской вкладке «Популярное» (G1). Меньше — выше.
  featuredOrder  Int             @default(0)
  // Сквозные теги поводов витрины (G1): BIRTHDAY, NEW_YEAR, MARCH_8 и т.д.
  occasionTags   String[]        @default([])
  aiProvider     String?
  aiModel        String?
  aiConfig       Json?
  processingType ProcessingType

  // Data-driven gift factory pipeline (P1+)
  pipelineConfig     Json?
  userInputForm      Json?
  priceCoinsStandard Int?
  priceCoinsPro      Int?
  previewImage       String?
  previewVideo       String?
  previewMode        String  @default("auto")
  // Кадрирование обложки для витрины (16:10). Нормализованный прямоугольник { x, y, w, h } в
  // долях натурального изображения; null => показываем центр (object-cover). Non-destructive.
  coverCrop          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trends   Trend[]
  projects Project[]
}

// === Определения категорий услуг (data-driven, P9.2+) ===
model ServiceCategoryDef {
  code             String   @id
  // Вкладка витрины, в которой живёт категория (G1): services | greetings.
  section          String   @default("services")
  title            String
  description      String?  @db.Text
  shortDescription String?  @db.Text
  iconName         String?
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum ProcessingType {
  AUTO // услуги 1-3: полный автомат
  MANUAL // услуги 4-5: только ручной заказ
  HYBRID // услуга 6: AI-генерация части + ручная часть
}

// === Тренды ===
model Trend {
  id             String   @id @default(cuid())
  title          String
  description    String?
  previewVideo   String
  referenceImg   String?
  referenceVideo String?
  prompt         String   @db.Text
  negativePrompt String?  @db.Text
  aiProvider     String
  aiModel        String
  aiConfig       Json
  tags           String[]
  priceTokens    Int?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  viewsCount     Int      @default(0)
  usedCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  serviceId String
  service   Service   @relation(fields: [serviceId], references: [id])
  projects  Project[]
}

// === Проекты (услуги 1-3) ===
model Project {
  id        String        @id @default(cuid())
  userId    String
  serviceId String?
  trendId   String?
  mode      String        @default("service")
  title     String
  status    ProjectStatus @default(PENDING)
  progress  Int           @default(0)

  inputImages String[]
  inputText   String?  @db.Text

  resultImage     String?
  resultVideo     String?
  resultThumbnail String?
  // Multi-output results (e.g. carousel slides). Array of { type, url, label? }.
  resultAssets    Json?

  tokensCost   Int
  errorMessage String? @db.Text
  errorCode    String?

  aiProviderJobId String?
  aiProviderLogs  Json?

  pipelineSnapshot Json?
  selectedTier     String?
  userInputs       Json?
  stepProgress     Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  expiresAt   DateTime?

  user        User         @relation(fields: [userId], references: [id])
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  trend       Trend?       @relation(fields: [trendId], references: [id], onDelete: SetNull)
  aiUsageLogs AIUsageLog[]
  chatMessages ChatMessage[]

  @@index([userId, mode])
  @@index([expiresAt])
}

model Chat {
  id        String   @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@index([deletedAt])
}

model ChatMessage {
  id        String   @id @default(uuid())
  chatId    String
  createdAt DateTime @default(now())

  prompt      String @db.Text
  modelSlug   String
  aspectRatio String?
  duration    Int?
  inputRef    String?
  projectId   String

  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model SupportTicket {
  id           String              @id @default(uuid())
  userId       String
  subject      String
  status       SupportTicketStatus @default(OPEN)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  resolvedAt   DateTime?
  resolvedById String?

  user       User                 @relation("SupportTicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User?                @relation("SupportTicketResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  messages   SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  body      String?  @db.Text
  createdAt DateTime @default(now())

  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User                @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model SupportAttachment {
  id         String                @id @default(uuid())
  messageId  String
  fileName   String
  mimeType   String
  fileSize   Int
  storageKey String
  publicUrl  String
  kind       SupportAttachmentKind
  createdAt  DateTime              @default(now())

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// === Редактор видео (G4) ===
// Ролик, который пользователь собирает сам. Вся раскладка живёт в timeline —
// той же схеме, что читают предпросмотр в браузере и рендер на сервере.
model VideoProject {
  id        String   @id @default(uuid())
  userId    String
  title     String
  timeline  Json
  /// Последний экспорт: Project с mode = "video-export".
  lastExportId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([deletedAt])
}

// === Поздравления на заказ (G6) ===
// Тип заказа целиком настраивается в админке: поля брифа, вилка цен, письма.
// Новый вид заказа не требует кода — только заполненной формы в /admin/order-types.
model OrderTypeDef {
  id          String  @id @default(uuid())
  slug        String  @unique
  title       String
  shortDesc   String
  description String  @db.Text
  coverImage  String?
  previewVideo String?
  /// Поля брифа (схема в @allvision/shared).
  briefFields Json
  priceFromCoins Int
  priceToCoins   Int
  /// Ориентировочный срок в днях — показывается на карточке.
  leadTimeDays Int @default(5)
  /// Письма по статусам: { QUOTED: { subject, body }, ... }
  emailTemplates Json?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders CustomOrder[]

  @@index([isActive, sortOrder])
}

model CustomOrder {
  id     String            @id @default(uuid())
  userId String
  /// Тип может быть удалён админом; заявка при этом должна выжить.
  orderTypeId String?
  /// Название типа на момент заявки — чтобы карточка читалась и после удаления типа.
  typeTitle   String
  status CustomOrderStatus @default(NEW)

  /// Ответы на поля брифа.
  brief       Json
  attachments String[]
  contactName  String
  contactEmail String
  contactPhone String?

  /// Цена, которую назначил админ после разбора брифа.
  quotedPriceCoins Int?
  adminNote        String? @db.Text
  resultUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderType OrderTypeDef? @relation(fields: [orderTypeId], references: [id], onDelete: SetNull)
  messages  CustomOrderMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

/// Переписка по заявке: вопросы админа и ответы заказчика.
model CustomOrderMessage {
  id       String  @id @default(uuid())
  orderId  String
  /// Автор: null — системное сообщение о смене статуса.
  authorId String?
  fromAdmin Boolean @default(false)
  body     String  @db.Text
  createdAt DateTime @default(now())

  order  CustomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

enum CustomOrderStatus {
  NEW
  QUOTED
  PAID
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

// === Заявки с заглушек будущих разделов (G1) ===
model WaitlistLead {
  id        String   @id @default(uuid())
  topic     String
  email     String
  name      String?
  comment   String?  @db.Text
  userId    String?
  createdAt DateTime @default(now())

  @@index([topic, createdAt])
}

enum SupportTicketStatus {
  OPEN
  RESOLVED
}

enum SupportAttachmentKind {
  IMAGE
  FILE
}

enum ProjectStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// === Заказы (услуги 4-5-6) ===
model Order {
  id     String      @id @default(cuid())
  userId String
  type   OrderType
  status OrderStatus @default(NEW)

  durationMinutes Int
  scenario        String   @db.Text
  referenceFiles  String[]
  contactInfo     String

  adminNotes       String? @db.Text
  scenesCount      Int?
  charactersCount  Int?
  complexityFactor Float?

  priceRub    Int?
  priceTokens Int?

  resultVideo     String?
  resultDelivered Boolean @default(false)

  fairyTaleScriptId String?                @unique
  fairyTaleScript   FairyTaleScriptRecord? @relation(fields: [fairyTaleScriptId], references: [id])
  fairyTaleTier     FairyTaleTier?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])
}

enum OrderType {
  CARTOON
  REALISTIC
  FAIRY_TALE
}

enum FairyTaleTier {
  BASIC
  EXTENDED
}

enum OrderStatus {
  NEW
  NEGOTIATING
  PRICE_SET
  PAID
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

// === Сценарии сказок (услуга 6) ===
model FairyTaleScriptRecord {
  id                String  @id @default(cuid())
  userId            String
  childName         String
  childAge          Int
  moralLesson       String  @db.Text
  additionalDetails String? @db.Text
  durationMinutes   Int     @default(3)

  title   String
  content Json
  rawText String @db.Text

  tokensCost Int
  isApproved Boolean   @default(false)
  approvedAt DateTime?

  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order?
}

// === Платежи ===
model Payment {
  id                String         @id @default(cuid())
  userId            String
  amountRub         Int
  tokensAdded       Int?
  status            PaymentStatus  @default(PENDING)
  provider          String         @default("mock")
  providerPaymentId String?
  purpose           PaymentPurpose
  metadata          Json?
  createdAt         DateTime       @default(now())
  expiresAt         DateTime?
  paidAt            DateTime?

  user      User       @relation(fields: [userId], references: [id])
  order     Order?
  character Character?
  scene     Scene?

  @@index([status, expiresAt])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentPurpose {
  TOPUP
  ORDER
}

// === AI-персонажи ===
model Character {
  id          String           @id @default(cuid())
  userId      String
  name        String
  type        CharacterType
  gender      CharacterGender?
  ageGroup    String?
  description String?          @db.Text

  // Reference images — основа подхода
  referenceImages String[]
  primaryImageId  Int      @default(0)

  // Метаданные
  consentGiven Boolean         @default(false)
  consentAt    DateTime?
  nsfwChecked  Boolean         @default(false)
  status       CharacterStatus @default(DRAFT)

  // Статистика
  episodesCount Int       @default(0)
  lastUsedAt    DateTime?

  // Тарификация
  isPaid    Boolean @default(false)
  paymentId String? @unique

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id])
  payment  Payment?           @relation(fields: [paymentId], references: [id])
  episodes EpisodeCharacter[]
  reports  AbuseReport[]
}

enum CharacterType {
  HUMAN
  PET
  GROUP
  MASCOT
}

enum CharacterGender {
  MALE
  FEMALE
  OTHER
}

enum CharacterStatus {
  DRAFT
  PROCESSING
  READY
  REJECTED
  PAYMENT_PENDING
}

// === Сцены (локации) ===
model Scene {
  id              String   @id @default(cuid())
  userId          String
  name            String
  description     String   @db.Text
  referenceImages String[]
  category        String?

  isPaid    Boolean @default(false)
  paymentId String? @unique

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  payment  Payment?  @relation(fields: [paymentId], references: [id])
  episodes Episode[]
}

// === Эпизоды (генерации с персонажами/сценами) ===
model Episode {
  id       String        @id @default(cuid())
  userId   String
  title    String
  status   EpisodeStatus @default(PENDING)
  progress Int           @default(0)

  // Откуда сценарий
  templateId     String?
  customScenario String? @db.Text

  // Параметры
  durationSeconds Int     @default(5)
  style           String?
  aspectRatio     String  @default("9:16")

  // Сцена
  sceneId String?

  // Результаты
  resultImage     String?
  resultVideo     String?
  resultThumbnail String?

  // Тарификация
  tokensCost   Int
  errorMessage String? @db.Text

  // AI-метаданные
  aiProviderJobId String?
  aiProviderLogs  Json?

  // Соцшеринг
  isPublic         Boolean @default(false)
  shareCount       Int     @default(0)
  watermarkRemoved Boolean @default(false)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user       User               @relation(fields: [userId], references: [id])
  template   ScenarioTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scene      Scene?             @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  characters EpisodeCharacter[]
  reports    AbuseReport[]
}

enum EpisodeStatus {
  PENDING
  PROCESSING_IMAGE
  PROCESSING_VIDEO
  COMPLETED
  FAILED
}

// === Связь Эпизодов и Персонажей (M:N) ===
model EpisodeCharacter {
  episodeId   String
  characterId String
  role        String?

  episode   Episode   @relation(fields: [episodeId], references: [id])
  character Character @relation(fields: [characterId], references: [id])

  @@id([episodeId, characterId])
}

// === Шаблоны сценариев (каталог) ===
model ScenarioTemplate {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  shortDesc   String
  description String @db.Text
  category    String

  previewVideo String
  previewImage String

  // Конфиг
  promptTemplate      String  @db.Text
  characterRoles      Json
  needsScene          Boolean @default(false)
  recommendedDuration Int     @default(10)
  defaultStyle        String  @default("cinematic")

  aiProvider String @default("fal")
  aiModel    String
  aiConfig   Json

  priceTokens Int

  tags            String[]
  popularityScore Int      @default(0)
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episodes Episode[]
}

// === Жалобы на злоупотребления ===
model AbuseReport {
  id             String       @id @default(cuid())
  reporterUserId String?
  reporterEmail  String?
  characterId    String?
  episodeId      String?
  reason         AbuseReason
  description    String       @db.Text
  status         ReportStatus @default(NEW)
  adminNotes     String?      @db.Text
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  character Character? @relation(fields: [characterId], references: [id])
  episode   Episode?   @relation(fields: [episodeId], references: [id])
}

enum AbuseReason {
  UNCONSENTED_FACE
  CELEBRITY
  MINOR
  HARASSMENT
  DEFAMATION
  OTHER
}

enum ReportStatus {
  NEW
  REVIEWING
  RESOLVED_REMOVED
  RESOLVED_NO_ACTION
  REJECTED
}

// === Транзакции токенов (лог) ===
model TokenTransaction {
  id           String   @id @default(cuid())
  userId       String
  amount       Int
  reason       String
  refId        String?
  balanceAfter Int
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// === Лог реальных и тестовых AI-вызовов ===
model AIUsageLog {
  id                   String   @id @default(uuid())
  createdAt            DateTime @default(now())
  projectId            String?
  userId               String?
  blockSlug            String
  provider             String
  model                String
  taskId               String?
  status               String
  costUsd              Float
  durationMs           Int
  errorCode            String?
  errorMessage         String?
  recoverableOutputUrl String?
  requestPayload       Json?
  responsePayload      Json?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([projectId])
}

// === Пакеты токенов ===
model MediaAsset {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kind        String
  groupCode   String?
  title       String
  description String?
  tags        String[]
  ownerUserId String?
  parentAssetId String?

  storageKey   String
  publicUrl    String
  thumbnailKey String?

  durationSec Float?
  width       Int?
  height      Int?
  frameCount  Int?
  fileSize    Int
  mimeType    String

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  parentAsset MediaAsset? @relation("MediaAssetVariations", fields: [parentAssetId], references: [id], onDelete: SetNull)
  variations MediaAsset[] @relation("MediaAssetVariations")

  @@index([kind])
  @@index([kind, groupCode])
  @@index([ownerUserId, kind])
  @@index([parentAssetId])
  @@index([isActive, sortOrder])
}

model StylePreset {
  id          String   @id @default(uuid())
  slug        String   @unique
  kind        String
  title       String
  description String
  promptText  String   @db.Text
  thumbnail   String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([kind, isActive, sortOrder])
}

model TokenPackage {
  id               String   @id @default(cuid())
  title            String
  subtitle         String?
  tokens           Int
  priceRub         Int
  originalPriceRub Int?
  bonus            Int      @default(0)
  badgeText        String?
  features         String[] @default([])
  isPopular        Boolean  @default(false)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
}

// === Настройки (key-value) ===
model Setting {
  key   String @id
  value String @db.Text
}
