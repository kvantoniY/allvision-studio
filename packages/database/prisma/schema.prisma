generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Пользователи ===
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  avatar        String?
  tokenBalance  Int       @default(0)
  role          Role      @default(USER)
  messenger     String?
  messengerType MessengerType?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  createdAt     DateTime  @default(now())

  projects      Project[]
  payments      Payment[]
  orders        Order[]
  tokenTxns     TokenTransaction[]
  fairyTales    FairyTaleScriptRecord[]
}

enum Role {
  USER
  ADMIN
}

enum MessengerType {
  TELEGRAM
  WHATSAPP
  VK
  PHONE
}

// === Каталог услуг ===
model Service {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String    @db.Text
  shortDesc       String
  category        ServiceCategory
  priceTokens     Int
  costUsd         Float
  coverImage      String?
  galleryImages   String[]
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  aiProvider      String?
  aiModel         String?
  aiConfig        Json?
  processingType  ProcessingType
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trends          Trend[]
  projects        Project[]
}

enum ServiceCategory {
  PHOTO_RESTORE
  PHOTO_ANIMATE
  TREND
  CARTOON_CUSTOM
  REALISTIC_CUSTOM
  FAIRY_TALE
}
enum ProcessingType {
  AUTO   // услуги 1-3: полный автомат
  MANUAL // услуги 4-5: только ручной заказ
  HYBRID // услуга 6: AI-генерация части + ручная часть
}

// === Тренды ===
model Trend {
  id              String    @id @default(cuid())
  title           String
  description     String?
  previewVideo    String
  referenceImg    String?
  referenceVideo  String?
  prompt          String    @db.Text
  negativePrompt  String?   @db.Text
  aiProvider      String
  aiModel         String
  aiConfig        Json
  tags            String[]
  priceTokens     Int
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  viewsCount      Int       @default(0)
  usedCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  serviceId       String
  service         Service   @relation(fields: [serviceId], references: [id])
  projects        Project[]
}

// === Проекты (услуги 1-3) ===
model Project {
  id              String         @id @default(cuid())
  userId          String
  serviceId       String
  trendId         String?
  title           String
  status          ProjectStatus  @default(PENDING)
  progress        Int            @default(0)

  inputImages     String[]
  inputText       String?        @db.Text

  resultImage     String?
  resultVideo     String?
  resultThumbnail String?

  tokensCost      Int
  errorMessage    String?        @db.Text

  aiProviderJobId String?
  aiProviderLogs  Json?

  createdAt       DateTime       @default(now())
  completedAt     DateTime?

  user            User           @relation(fields: [userId], references: [id])
  service         Service        @relation(fields: [serviceId], references: [id])
  trend           Trend?         @relation(fields: [trendId], references: [id])
}

enum ProjectStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// === Заказы (услуги 4-5-6) ===
model Order {
  id               String       @id @default(cuid())
  userId           String
  type             OrderType
  status           OrderStatus  @default(NEW)

  durationMinutes  Int
  scenario         String       @db.Text
  referenceFiles   String[]
  contactInfo      String

  adminNotes       String?      @db.Text
  scenesCount      Int?
  charactersCount  Int?
  complexityFactor Float?

  priceRub         Int?
  priceTokens      Int?

  resultVideo      String?
  resultDelivered  Boolean      @default(false)

  fairyTaleScriptId String?     @unique
  fairyTaleScript   FairyTaleScriptRecord? @relation(fields: [fairyTaleScriptId], references: [id])
  fairyTaleTier     FairyTaleTier?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User         @relation(fields: [userId], references: [id])
  paymentId        String?      @unique
  payment          Payment?     @relation(fields: [paymentId], references: [id])
}

enum OrderType {
  CARTOON
  REALISTIC
  FAIRY_TALE
}

enum FairyTaleTier {
  BASIC
  EXTENDED
}
enum OrderStatus {
  NEW
  NEGOTIATING
  PRICE_SET
  PAID
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

// === Сценарии сказок (услуга 6) ===
model FairyTaleScriptRecord {
  id                String    @id @default(cuid())
  userId            String
  childName         String
  childAge          Int
  moralLesson       String    @db.Text
  additionalDetails String?   @db.Text
  durationMinutes   Int       @default(3)

  title             String
  content           Json
  rawText           String    @db.Text

  tokensCost        Int
  isApproved        Boolean   @default(false)
  approvedAt        DateTime?

  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id])
  order             Order?
}

// === Платежи ===
model Payment {
  id                String        @id @default(cuid())
  userId            String
  amountRub         Int
  tokensAdded       Int?
  status            PaymentStatus @default(PENDING)
  provider          String        @default("mock")
  providerPaymentId String?
  purpose           PaymentPurpose
  metadata          Json?
  createdAt         DateTime      @default(now())
  paidAt            DateTime?

  user              User          @relation(fields: [userId], references: [id])
  order             Order?
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentPurpose {
  TOPUP
  ORDER
}

// === Транзакции токенов (лог) ===
model TokenTransaction {
  id           String    @id @default(cuid())
  userId       String
  amount       Int
  reason       String
  refId        String?
  balanceAfter Int
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id])
}

// === Пакеты токенов ===
model TokenPackage {
  id          String   @id @default(cuid())
  title       String
  tokens      Int
  priceRub    Int
  bonus       Int      @default(0)
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
}

// === Настройки (key-value) ===
model Setting {
  key   String @id
  value String @db.Text
}
