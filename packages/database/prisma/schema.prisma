generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Пользователи ===
model User {
  id                     String         @id @default(cuid())
  email                  String         @unique
  passwordHash           String
  name                   String?
  avatar                 String?
  tokenBalance           Int            @default(0)
  freeCharacterUsed      Boolean        @default(false)
  role                   Role           @default(USER)
  messenger              String?
  messengerType          MessengerType?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  deletedAt              DateTime?
  createdAt              DateTime       @default(now())

  projects   Project[]
  payments   Payment[]
  orders     Order[]
  tokenTxns  TokenTransaction[]
  fairyTales FairyTaleScriptRecord[]
  characters Character[]
  scenes     Scene[]
  episodes   Episode[]
}

enum Role {
  USER
  ADMIN
}

enum MessengerType {
  TELEGRAM
  WHATSAPP
  VK
  PHONE
}

// === Каталог услуг ===
model Service {
  id             String          @id @default(cuid())
  slug           String          @unique
  title          String
  description    String          @db.Text
  shortDesc      String
  category       ServiceCategory
  priceTokens    Int
  costUsd        Float
  coverImage     String?
  galleryImages  String[]
  isActive       Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  sortOrder      Int             @default(0)
  aiProvider     String?
  aiModel        String?
  aiConfig       Json?
  processingType ProcessingType

  // Data-driven gift factory pipeline (P1+)
  pipelineConfig     Json?
  userInputForm      Json?
  priceCoinsStandard Int?
  priceCoinsPro      Int?
  previewImage       String?
  previewVideo       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trends   Trend[]
  projects Project[]
}

enum ServiceCategory {
  PHOTO_RESTORE
  PHOTO_ANIMATE
  TREND
  CARTOON_CUSTOM
  REALISTIC_CUSTOM
  FAIRY_TALE

  // Gift factory categories (P1+)
  NOSTALGIA
  TRENDS_MEMES
  KIDS_HEROES
  SPECIAL_OCCASIONS
}

enum ProcessingType {
  AUTO // услуги 1-3: полный автомат
  MANUAL // услуги 4-5: только ручной заказ
  HYBRID // услуга 6: AI-генерация части + ручная часть
}

// === Тренды ===
model Trend {
  id             String   @id @default(cuid())
  title          String
  description    String?
  previewVideo   String
  referenceImg   String?
  referenceVideo String?
  prompt         String   @db.Text
  negativePrompt String?  @db.Text
  aiProvider     String
  aiModel        String
  aiConfig       Json
  tags           String[]
  priceTokens    Int?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  viewsCount     Int      @default(0)
  usedCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  serviceId String
  service   Service   @relation(fields: [serviceId], references: [id])
  projects  Project[]
}

// === Проекты (услуги 1-3) ===
model Project {
  id        String        @id @default(cuid())
  userId    String
  serviceId String?
  trendId   String?
  title     String
  status    ProjectStatus @default(PENDING)
  progress  Int           @default(0)

  inputImages String[]
  inputText   String?  @db.Text

  resultImage     String?
  resultVideo     String?
  resultThumbnail String?

  tokensCost   Int
  errorMessage String? @db.Text
  errorCode    String?

  aiProviderJobId String?
  aiProviderLogs  Json?

  pipelineSnapshot Json?
  selectedTier     String?
  userInputs       Json?
  stepProgress     Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user    User     @relation(fields: [userId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  trend   Trend?   @relation(fields: [trendId], references: [id], onDelete: SetNull)
  aiUsageLogs AIUsageLog[]
}

enum ProjectStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// === Заказы (услуги 4-5-6) ===
model Order {
  id     String      @id @default(cuid())
  userId String
  type   OrderType
  status OrderStatus @default(NEW)

  durationMinutes Int
  scenario        String   @db.Text
  referenceFiles  String[]
  contactInfo     String

  adminNotes       String? @db.Text
  scenesCount      Int?
  charactersCount  Int?
  complexityFactor Float?

  priceRub    Int?
  priceTokens Int?

  resultVideo     String?
  resultDelivered Boolean @default(false)

  fairyTaleScriptId String?                @unique
  fairyTaleScript   FairyTaleScriptRecord? @relation(fields: [fairyTaleScriptId], references: [id])
  fairyTaleTier     FairyTaleTier?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])
}

enum OrderType {
  CARTOON
  REALISTIC
  FAIRY_TALE
}

enum FairyTaleTier {
  BASIC
  EXTENDED
}

enum OrderStatus {
  NEW
  NEGOTIATING
  PRICE_SET
  PAID
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

// === Сценарии сказок (услуга 6) ===
model FairyTaleScriptRecord {
  id                String  @id @default(cuid())
  userId            String
  childName         String
  childAge          Int
  moralLesson       String  @db.Text
  additionalDetails String? @db.Text
  durationMinutes   Int     @default(3)

  title   String
  content Json
  rawText String @db.Text

  tokensCost Int
  isApproved Boolean   @default(false)
  approvedAt DateTime?

  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order?
}

// === Платежи ===
model Payment {
  id                String         @id @default(cuid())
  userId            String
  amountRub         Int
  tokensAdded       Int?
  status            PaymentStatus  @default(PENDING)
  provider          String         @default("mock")
  providerPaymentId String?
  purpose           PaymentPurpose
  metadata          Json?
  createdAt         DateTime       @default(now())
  paidAt            DateTime?

  user      User       @relation(fields: [userId], references: [id])
  order     Order?
  character Character?
  scene     Scene?
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentPurpose {
  TOPUP
  ORDER
}

// === AI-персонажи ===
model Character {
  id          String           @id @default(cuid())
  userId      String
  name        String
  type        CharacterType
  gender      CharacterGender?
  ageGroup    String?
  description String?          @db.Text

  // Reference images — основа подхода
  referenceImages String[]
  primaryImageId  Int      @default(0)

  // Метаданные
  consentGiven Boolean         @default(false)
  consentAt    DateTime?
  nsfwChecked  Boolean         @default(false)
  status       CharacterStatus @default(DRAFT)

  // Статистика
  episodesCount Int       @default(0)
  lastUsedAt    DateTime?

  // Тарификация
  isPaid    Boolean @default(false)
  paymentId String? @unique

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id])
  payment  Payment?           @relation(fields: [paymentId], references: [id])
  episodes EpisodeCharacter[]
  reports  AbuseReport[]
}

enum CharacterType {
  HUMAN
  PET
  GROUP
  MASCOT
}

enum CharacterGender {
  MALE
  FEMALE
  OTHER
}

enum CharacterStatus {
  DRAFT
  PROCESSING
  READY
  REJECTED
  PAYMENT_PENDING
}

// === Сцены (локации) ===
model Scene {
  id              String   @id @default(cuid())
  userId          String
  name            String
  description     String   @db.Text
  referenceImages String[]
  category        String?

  isPaid    Boolean @default(false)
  paymentId String? @unique

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  payment  Payment?  @relation(fields: [paymentId], references: [id])
  episodes Episode[]
}

// === Эпизоды (генерации с персонажами/сценами) ===
model Episode {
  id       String        @id @default(cuid())
  userId   String
  title    String
  status   EpisodeStatus @default(PENDING)
  progress Int           @default(0)

  // Откуда сценарий
  templateId     String?
  customScenario String? @db.Text

  // Параметры
  durationSeconds Int     @default(5)
  style           String?
  aspectRatio     String  @default("9:16")

  // Сцена
  sceneId String?

  // Результаты
  resultImage     String?
  resultVideo     String?
  resultThumbnail String?

  // Тарификация
  tokensCost   Int
  errorMessage String? @db.Text

  // AI-метаданные
  aiProviderJobId String?
  aiProviderLogs  Json?

  // Соцшеринг
  isPublic         Boolean @default(false)
  shareCount       Int     @default(0)
  watermarkRemoved Boolean @default(false)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user       User               @relation(fields: [userId], references: [id])
  template   ScenarioTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scene      Scene?             @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  characters EpisodeCharacter[]
  reports    AbuseReport[]
}

enum EpisodeStatus {
  PENDING
  PROCESSING_IMAGE
  PROCESSING_VIDEO
  COMPLETED
  FAILED
}

// === Связь Эпизодов и Персонажей (M:N) ===
model EpisodeCharacter {
  episodeId   String
  characterId String
  role        String?

  episode   Episode   @relation(fields: [episodeId], references: [id])
  character Character @relation(fields: [characterId], references: [id])

  @@id([episodeId, characterId])
}

// === Шаблоны сценариев (каталог) ===
model ScenarioTemplate {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  shortDesc   String
  description String @db.Text
  category    String

  previewVideo String
  previewImage String

  // Конфиг
  promptTemplate      String  @db.Text
  characterRoles      Json
  needsScene          Boolean @default(false)
  recommendedDuration Int     @default(10)
  defaultStyle        String  @default("cinematic")

  aiProvider String @default("fal")
  aiModel    String
  aiConfig   Json

  priceTokens Int

  tags            String[]
  popularityScore Int      @default(0)
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episodes Episode[]
}

// === Жалобы на злоупотребления ===
model AbuseReport {
  id             String       @id @default(cuid())
  reporterUserId String?
  reporterEmail  String?
  characterId    String?
  episodeId      String?
  reason         AbuseReason
  description    String       @db.Text
  status         ReportStatus @default(NEW)
  adminNotes     String?      @db.Text
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  character Character? @relation(fields: [characterId], references: [id])
  episode   Episode?   @relation(fields: [episodeId], references: [id])
}

enum AbuseReason {
  UNCONSENTED_FACE
  CELEBRITY
  MINOR
  HARASSMENT
  DEFAMATION
  OTHER
}

enum ReportStatus {
  NEW
  REVIEWING
  RESOLVED_REMOVED
  RESOLVED_NO_ACTION
  REJECTED
}

// === Транзакции токенов (лог) ===
model TokenTransaction {
  id           String   @id @default(cuid())
  userId       String
  amount       Int
  reason       String
  refId        String?
  balanceAfter Int
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// === Лог реальных и тестовых AI-вызовов ===
model AIUsageLog {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  projectId    String?
  userId       String?
  blockSlug    String
  provider     String
  model        String
  taskId       String?
  status       String
  costUsd      Float
  durationMs   Int
  errorCode    String?
  errorMessage String?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([projectId])
}

// === Пакеты токенов ===
model MediaAsset {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  kind         String
  title        String
  description  String?
  tags         String[]

  storageKey   String
  publicUrl    String
  thumbnailKey String?

  durationSec  Float?
  width        Int?
  height       Int?
  frameCount   Int?
  fileSize     Int
  mimeType     String

  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)

  @@index([kind])
  @@index([isActive, sortOrder])
}

model TokenPackage {
  id        String  @id @default(cuid())
  title     String
  tokens    Int
  priceRub  Int
  bonus     Int     @default(0)
  isPopular Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

// === Настройки (key-value) ===
model Setting {
  key   String @id
  value String @db.Text
}
