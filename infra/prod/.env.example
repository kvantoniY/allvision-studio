# === Core ===
NODE_ENV=production
PORT=4000

# === Database ===
POSTGRES_DB=allvision_studio
POSTGRES_USER=allvision
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://allvision:CHANGE_ME@postgres:5432/allvision_studio

# === Redis ===
REDIS_URL=redis://redis:6379

# === Auth ===
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_64_CHARS
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
TRUST_PROXY_HOPS=2
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT=10
AUTH_LOGIN_RATE_LIMIT=5
PASSWORD_RESET_RATE_LIMIT=3
EMAIL_VERIFICATION_RATE_LIMIT=3

# === URLs ===
PUBLIC_API_URL=https://allvision-pulse.ru
PUBLIC_WEB_URL=https://allvision-pulse.ru
NEXT_PUBLIC_API_URL=https://allvision-pulse.ru
NEXT_PUBLIC_YANDEX_SMARTCAPTCHA_SITE_KEY=
NEXT_PUBLIC_CAPTCHA_ENABLED=
CORS_ORIGIN=https://allvision-pulse.ru

# === Yandex SmartCaptcha ===
CAPTCHA_ENABLED=
YANDEX_SMARTCAPTCHA_SECRET_KEY=
YANDEX_SMARTCAPTCHA_VERIFY_URL=https://smartcaptcha.cloud.yandex.ru/validate

# === Transactional email (Unisender Go) ===
MAIL_PROVIDER=unisender
UNISENDER_API_KEY=
UNISENDER_BASE_URL=https://goapi.unisender.ru/ru/transactional/api/v1
MAIL_FROM_EMAIL=noreply@allvision-pulse.ru
MAIL_FROM_NAME=Allvision Studio

# === Files ===
UPLOADS_DIR=/app/uploads

# === Bonuses ===
WELCOME_TOKENS_BONUS=0

# === Admin (set on first deploy) ===
ADMIN_EMAIL=admin@allvision-pulse.ru
ADMIN_PASSWORD=CHANGE_ME_AT_FIRST_DEPLOY
# Legacy aliases are still supported by seed.ts:
# ADMIN_INITIAL_EMAIL=admin@allvision-pulse.ru
# ADMIN_INITIAL_PASSWORD=CHANGE_ME_AT_FIRST_DEPLOY
READONLY_ADMIN_EMAIL=claude-readonly@allvision-pulse.ru
READONLY_ADMIN_PASSWORD=CHANGE_ME_AT_FIRST_DEPLOY
READONLY_ADMIN_ACCESS_TTL_MIN=1440

# === Providers ===
# mock - safe default, all AI blocks use mocks. piapi - real PiAPI calls.
PROVIDER_MODE=mock

# Storage publisher (for PiAPI mode)
# local - files are served by our nginx through /static/
# r2 - Cloudflare R2 (requires R2_* env)
# noop - for mock/manual testing
STORAGE_PUBLISHER=local

# === fal.ai (only for PROVIDER_MODE=fal) ===
# Миграция, см. docs/FAL_MIGRATION_ROLLBACK.md. Откат: PROVIDER_MODE=piapi + restart worker.
# Ключ в формате key_id:key_secret из fal.ai/dashboard/keys
FAL_KEY=
# По умолчанию https://queue.fal.run
FAL_QUEUE_BASE_URL=
# REST-хост fal для загрузки видео-входов (по умолчанию https://rest.alpha.fal.ai). Менять только
# если fal сменит домен storage upload.
FAL_REST_BASE_URL=
# Какие блоки идут через fal (остальные -> PiAPI). Default: image-edit,text-to-video,image-to-video
FAL_BLOCKS=
# Заходы на скачивание готового (уже оплаченного) результата с fal CDN при флапе egress
# (UND_ERR_CONNECT_TIMEOUT с РФ-ВМ). Бэкофф 3с/10с/25с/60с, default 5.
FAL_DOWNLOAD_RETRY_ATTEMPTS=5
# CONNECT-прокси для фолбэка скачивания с fal CDN (нечётные заходы идут через него).
# Пусто -> берётся PIAPI_PROXY_URL (зарубежный VPS из P10.2) — на проде уже задан.
FAL_PROXY_URL=
# Ключ с правами Account/Billing (fal dashboard) — для баланса в админке и точной стоимости
# (api.fal.ai/v1/account/billing, /models/billing-events). Если пусто — берётся FAL_KEY (у него обычно
# нет прав на биллинг -> баланс отдаст 403). Модельный FAL_KEY на запуск это не заменяет.
FAL_BILLING_KEY=
# Порог низкого баланса fal (USD) для подсветки в диагностике.
FAL_BALANCE_MIN_USD=2

# === PiAPI (PROVIDER_MODE=piapi; в режиме fal — фолбэк для нишевых блоков, ключ НЕ удалять) ===
PIAPI_API_KEY=
PIAPI_BASE_URL=https://api.piapi.ai
PIAPI_DAILY_CAP_USD=5
PIAPI_BALANCE_MIN_USD=2
# GPT Image отвечает синхронно и может длиться дольше 30s (мс)
PIAPI_GPT_IMAGE_TIMEOUT_MS=180000
# Попытки gpt-image edit при раннем обрыве (RST до первого байта ответа = запрос не дошёл
# до PiAPI, задача не создана и не биллится). Поздние обрывы/таймауты не ретраятся.
PIAPI_GPT_IMAGE_EDIT_RETRIES=4
# Фоновый реконсайлер в API: доводит зависшие PiAPI-генерации до результата/refund
# без открытой вкладки юзера. Включен по умолчанию при заданном PIAPI_API_KEY.
PIAPI_RECONCILER_ENABLED=true
PIAPI_RECONCILE_INTERVAL_MS=45000
PIAPI_RECONCILE_LOOKBACK_MS=21600000
PIAPI_RECONCILE_BATCH=25
# Через сколько фейлить проект с refund, если потерянный sync-вызов (gpt-image)
# так и не появился в PiAPI history (мс)
PIAPI_SYNC_PENDING_FAIL_AFTER_MS=600000

# === Pricing ===
PRICING_MARGIN_DEFAULT=0.8
PRICING_USD_TO_RUB=80

# === R2 (only for STORAGE_PUBLISHER=r2) ===
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_TEMP_PREFIX=

# === SEO / Search engines (NEXT_PUBLIC_* are baked at web build time) ===
NEXT_PUBLIC_SITE_URL=https://allvision-pulse.ru
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_VERIFICATION=

NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_GA_ID=

# Proxy ONLY for synchronous gpt-image edits (foreign egress fixes ECONNRESET from the RU VM).
# Async models go direct. Format: http://user:pass@host:port
PIAPI_PROXY_URL=
